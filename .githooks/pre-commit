#!/bin/sh
# Runs the same quality gates CI uses. Installed via scripts/install-git-hooks.ps1.
set -e
ROOT="$(git rev-parse --show-toplevel)"
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$ROOT/scripts/invoke-quality-gates.ps1" -Quick
fi
exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$ROOT/scripts/invoke-quality-gates.ps1" -Quick
