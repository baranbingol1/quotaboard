#!/usr/bin/env bash
set -euo pipefail

readonly SDK_VERSION="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' global.json)"
readonly DOTNET_DIR="${HOME}/.dotnet"

if [[ -z "${SDK_VERSION}" ]]; then
  echo "Could not read the pinned .NET SDK version from global.json." >&2
  exit 1
fi

echo "Installing .NET runtime prerequisites..."
sudo -n env DEBIAN_FRONTEND=noninteractive apt-get update
sudo -n env DEBIAN_FRONTEND=noninteractive apt-get install -y \
  ca-certificates \
  curl \
  libicu72 \
  libssl3 \
  zlib1g

if [[ ! -x "${DOTNET_DIR}/dotnet" ]] || \
   ! "${DOTNET_DIR}/dotnet" --list-sdks 2>/dev/null | grep -Fq "${SDK_VERSION} ["; then
  echo "Installing .NET SDK ${SDK_VERSION}..."
  installer="$(mktemp)"
  trap 'rm -f "${installer}"' EXIT
  curl --fail --location --retry 3 \
    https://dot.net/v1/dotnet-install.sh \
    --output "${installer}"
  bash "${installer}" \
    --version "${SDK_VERSION}" \
    --install-dir "${DOTNET_DIR}" \
    --no-path
fi

# Lifecycle-script exports do not persist into later agent shells. Keep dotnet
# on the orb-wide PATH while leaving the SDK itself in the user's home folder.
sudo -n ln -sfn "${DOTNET_DIR}/dotnet" /usr/local/bin/dotnet

export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_NOLOGO=1
export DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1

echo "Restoring solution dependencies..."
# Linux can restore Windows targeting packs, although WinUI's native XAML
# compiler still requires Windows when the presentation projects are built.
dotnet restore AiLimits.slnx -p:EnableWindowsTargeting=true

echo "Orb setup complete (.NET SDK $(dotnet --version))."
