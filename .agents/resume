#!/usr/bin/env bash
set -euo pipefail

readonly SDK_VERSION="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' global.json)"
readonly USER_DOTNET="${HOME}/.dotnet/dotnet"

# There are no repository services to reconnect. Repair the PATH link if an
# orb wake preserved the SDK but not the system-level symlink.
if ! command -v dotnet >/dev/null 2>&1 && [[ -x "${USER_DOTNET}" ]]; then
  sudo -n ln -sfn "${USER_DOTNET}" /usr/local/bin/dotnet
fi

if ! command -v dotnet >/dev/null 2>&1 || \
   ! dotnet --list-sdks 2>/dev/null | grep -Fq "${SDK_VERSION} ["; then
  echo "Pinned .NET SDK ${SDK_VERSION} is unavailable; rerun .agents/setup." >&2
  exit 1
fi

echo "Orb resumed (.NET SDK ${SDK_VERSION}; no local services required)."
