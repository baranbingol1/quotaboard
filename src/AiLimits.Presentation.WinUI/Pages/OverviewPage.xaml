<Page
    x:Class="AiLimits.Presentation.WinUI.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AiLimits.Presentation.WinUI.Controls"
    xmlns:converters="using:AiLimits.Presentation.WinUI.Converters"
    xmlns:pages="using:AiLimits.Presentation.WinUI.Pages"
    Background="{ThemeResource PageBackgroundBrush}">
    <Page.Resources>
        <converters:StringVisibilityConverter x:Key="StringVisibility" />
        <converters:BooleanVisibilityConverter x:Key="BooleanVisibility" />
    </Page.Resources>
    <ScrollViewer>
        <Grid Padding="34,28,34,48" RowSpacing="24" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:AdaptiveHeaderPanel MinContentWidth="320" Spacing="20">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <TextBlock x:Uid="Overview_Eyebrow" Style="{StaticResource EyebrowTextStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Uid="Overview_Title" Style="{StaticResource PageTitleTextStyle}" Margin="0,6,0,0" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Margin="0,8,0,0"
                               Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringVisibility}}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="7">
                    <Button x:Uid="Overview_Refresh" Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" />
                    <StackPanel Spacing="4" MinWidth="180"
                                Visibility="{x:Bind ViewModel.IsRefreshing, Mode=OneWay, Converter={StaticResource BooleanVisibility}}">
                        <ProgressBar Value="{x:Bind ViewModel.RefreshProgressFraction, Mode=OneWay}"
                                     IsIndeterminate="{x:Bind ViewModel.RefreshIsIndeterminate, Mode=OneWay}"
                                     Maximum="1" Minimum="0" HorizontalAlignment="Stretch" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.RefreshProgressLabel, Mode=OneWay}"
                                       Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.RefreshProgressDetail, Mode=OneWay}"
                                       FontSize="11" Foreground="{ThemeResource TextQuietBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.LastUpdated, Mode=OneWay}" Style="{StaticResource EyebrowTextStyle}" HorizontalAlignment="Right" />
                </StackPanel>
            </controls:AdaptiveHeaderPanel>

            <Border Grid.Row="1" Style="{StaticResource SurfaceBorderStyle}" Padding="24,22">
                <pages:StatStrip MinCellWidth="200" ColumnSpacing="24" RowSpacing="26">
                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Uid="Overview_TotalTokens30Days" Style="{StaticResource EyebrowTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.TotalTokens, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="30"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.Coverage, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource TextQuietBrush}" TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Uid="Overview_ApiEquivalent30Days" Style="{StaticResource EyebrowTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.ApiEquivalentCost, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="30"
                                   Foreground="{ThemeResource FocusBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.CacheSavingsLabel, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Visibility="{x:Bind ViewModel.CacheSavingsLabel, Mode=OneWay, Converter={StaticResource StringVisibility}}" />
                    </StackPanel>

                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Uid="Overview_PlanValue" Style="{StaticResource EyebrowTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.PlanValueLabel, Mode=OneWay}" Style="{StaticResource MetricTextStyle}"
                                   FontSize="17" LineHeight="23" LineStackingStrategy="BlockLineHeight"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.PlanValueDetail, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextSecondaryBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Uid="Overview_TokenLanes" Style="{StaticResource EyebrowTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                        <Grid ColumnSpacing="22" RowSpacing="4" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="Overview_Input" Style="{StaticResource EyebrowTextStyle}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.InputTokens, Mode=OneWay}" FontFamily="{ThemeResource MetricFont}" FontSize="14" HorizontalAlignment="Right" />
                            <TextBlock x:Uid="Overview_Output" Grid.Row="1" Style="{StaticResource EyebrowTextStyle}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.OutputTokens, Mode=OneWay}" FontFamily="{ThemeResource MetricFont}" FontSize="14" HorizontalAlignment="Right" />
                            <TextBlock x:Uid="Overview_CacheRead" Grid.Row="2" Style="{StaticResource EyebrowTextStyle}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.CacheReadTokens, Mode=OneWay}" FontFamily="{ThemeResource MetricFont}" FontSize="14" HorizontalAlignment="Right" />
                            <TextBlock x:Uid="Overview_CacheWrite" Grid.Row="3" Style="{StaticResource EyebrowTextStyle}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.CacheWriteTokens, Mode=OneWay}" FontFamily="{ThemeResource MetricFont}" FontSize="14" HorizontalAlignment="Right" />
                            <TextBlock x:Uid="Overview_Reasoning" Grid.Row="4" Style="{StaticResource EyebrowTextStyle}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.ReasoningTokens, Mode=OneWay}" FontFamily="{ThemeResource MetricFont}" FontSize="14" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </pages:StatStrip>
            </Border>

            <StackPanel Grid.Row="2" Spacing="12">
                <controls:AdaptiveHeaderPanel MinContentWidth="300" Spacing="16">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock x:Uid="Overview_UsageByAuthProvider" Style="{StaticResource SectionTitleTextStyle}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <TextBlock x:Uid="Overview_GroupBy" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" Margin="0,0,3,0" />
                        <ToggleButton x:Name="GroupByProviderButton" x:Uid="Overview_GroupByProvider" IsChecked="True" Click="OnGroupByProviderClicked" MinHeight="28" Padding="10,4" FontSize="11" />
                        <ToggleButton x:Name="GroupByHarnessButton" x:Uid="Overview_GroupByHarness" Click="OnGroupByHarnessClicked" MinHeight="28" Padding="10,4" FontSize="11" />
                    </StackPanel>
                </controls:AdaptiveHeaderPanel>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ActiveUsageGrouping, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <!-- Every cell is the same height and anything taller is
                             clipped, so this must fit the worst case: a provider
                             with the full three model lines plus the coverage
                             caption. Too small and the bottom rows vanish without
                             a scrollbar or an ellipsis to show for it. -->
                        <UniformGridLayout MinItemWidth="270" MinItemHeight="202" MinRowSpacing="12" MinColumnSpacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border MinHeight="200" Style="{StaticResource SurfaceBorderStyle}">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="3" Background="{Binding Accent}" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Provider}" FontSize="18" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Provider}" />
                                            <TextBlock Text="{Binding Harnesses}" Foreground="{ThemeResource TextSecondaryBrush}"
                                                       FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Uid="Overview_Tokens" Style="{StaticResource EyebrowTextStyle}" />
                                            <TextBlock Text="{Binding Tokens}" Style="{StaticResource MetricTextStyle}" FontSize="21" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Uid="Overview_ApiEstimate" Style="{StaticResource EyebrowTextStyle}" />
                                            <TextBlock Text="{Binding ApiEquivalent}" Style="{StaticResource MetricTextStyle}" FontSize="21" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="2" Spacing="5">
                                        <TextBlock Text="{Binding Models}" FontSize="11.5" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding Models}"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding PricingCoverage}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding PricingCoverage}"
                                                   Foreground="{ThemeResource TextQuietBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="12">
                <StackPanel>
                    <TextBlock x:Uid="Overview_VerifiedPlanLimits" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock x:Uid="Overview_VerifiedPlanLimitsDescription"
                               Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Providers, Mode=OneWay}">
                    <ItemsControl.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="22" />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </ItemsControl.ItemContainerTransitions>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:WrapRowPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:ProviderCard Width="328" Margin="0,0,12,12" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Row="4" Spacing="12">
                <StackPanel>
                    <TextBlock x:Uid="Overview_NextResets" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock x:Uid="Overview_NextResetsDescription"
                               Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <controls:ResetHorizon DataContext="{x:Bind ViewModel.ResetHorizon, Mode=OneWay}" />
            </StackPanel>

            <Expander Grid.Row="5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Visibility="{x:Bind CountToVisibility(ViewModel.ResetCycles.Count), Mode=OneWay}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,12">
                        <TextBlock x:Uid="Overview_ResetCredits" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" />
                        <TextBlock x:Uid="Overview_ResetCreditsDescription" FontSize="13"
                                   Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Expander.Header>
                <ItemsControl ItemsSource="{x:Bind ViewModel.ResetCycles, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="1.1*" MinWidth="120" />
                                    <ColumnDefinition Width="1.3*" MinWidth="130" />
                                    <ColumnDefinition Width="2*" MinWidth="140" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="2" Background="{Binding Accent}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Provider}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Provider}" />
                                    <TextBlock Text="{Binding DisplayAccount}" FontSize="11" Foreground="{ThemeResource TextQuietBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Title}" FontFamily="{ThemeResource MetricFont}" FontSize="13"
                                           FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{Binding Title}" />
                                <TextBlock Grid.Column="3" Text="{Binding Detail}" Foreground="{ThemeResource TextSecondaryBrush}"
                                           FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </Grid>
    </ScrollViewer>
</Page>
