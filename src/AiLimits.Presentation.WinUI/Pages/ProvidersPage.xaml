<Page
    x:Class="AiLimits.Presentation.WinUI.Pages.ProvidersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AiLimits.Presentation.WinUI.Controls"
    xmlns:converters="using:AiLimits.Presentation.WinUI.Converters"
    Background="{ThemeResource PageBackgroundBrush}">
    <Page.Resources>
        <converters:StringVisibilityConverter x:Key="StringVisibility" />
        <converters:BooleanVisibilityConverter x:Key="BooleanVisibility" />
        <converters:CardStatusBrushConverter x:Key="CardStatusBrush" />
    </Page.Resources>
    <ScrollViewer>
        <Grid x:Name="ProvidersContentGrid" Padding="34,28,34,48" RowSpacing="20"
              SizeChanged="OnProvidersContentSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:AdaptiveHeaderPanel MinContentWidth="300" Spacing="16">
                <StackPanel x:Name="SummaryPanel" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock x:Uid="Providers_LoadingStatus" Foreground="{ThemeResource TextSecondaryBrush}"
                               Margin="0,0,0,9" TextWrapping="Wrap" />
                    <TextBlock x:Uid="Providers_Title" Style="{StaticResource PageTitleTextStyle}" Margin="0,4,0,0" />
                    <TextBlock x:Uid="Providers_Description"
                               Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <AutoSuggestBox x:Name="SearchBox" MaxWidth="290" MinWidth="150" HorizontalAlignment="Right"
                                x:Uid="Providers_Search" VerticalAlignment="Bottom"
                                QueryIcon="Find" TextChanged="OnSearchTextChanged" />
            </controls:AdaptiveHeaderPanel>

            <StackPanel Grid.Row="1" HorizontalAlignment="Right" Spacing="7">
                <Button x:Uid="Providers_RefreshDetection" Command="{x:Bind ViewModel.RefreshCommand}"
                        HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" />
                <!-- Same live progress strip as Overview and Usage: detection
                     takes long enough that a disabled gray button reads as a
                     hang rather than as work in flight. -->
                <!-- Fixed width, with the detail in a star column, keeps long
                     progress text inside the page at narrow widths. -->
                <StackPanel Spacing="4" Width="260"
                            Visibility="{x:Bind ViewModel.IsRefreshing, Mode=OneWay, Converter={StaticResource BooleanVisibility}}">
                    <ProgressBar Value="{x:Bind ViewModel.RefreshProgressFraction, Mode=OneWay}"
                                 IsIndeterminate="{x:Bind ViewModel.RefreshIsIndeterminate, Mode=OneWay}"
                                 Maximum="1" Minimum="0" HorizontalAlignment="Stretch" />
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.RefreshProgressLabel, Mode=OneWay}"
                                   Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RefreshProgressDetail, Mode=OneWay}"
                                   FontSize="11" Foreground="{ThemeResource TextQuietBrush}"
                                   VerticalAlignment="Center" TextAlignment="Right"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Column headers rendered once; the 18px insets and column set match
                 the row template below so everything lines up regardless of content. -->
            <Grid x:Name="WideColumnHeaders" Grid.Row="2" ColumnSpacing="18" Padding="18,0,18,2" Margin="0,2,0,-8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="1.3*" MinWidth="140" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" x:Uid="Providers_ColumnConnection" Style="{StaticResource EyebrowTextStyle}" />
                <TextBlock Grid.Column="2" x:Uid="Providers_AuthSource" Style="{StaticResource EyebrowTextStyle}" />
                <TextBlock Grid.Column="3" x:Uid="Providers_ColumnStatus" Style="{StaticResource EyebrowTextStyle}" />
                <TextBlock Grid.Column="4" x:Uid="Providers_WhatThisMeans" Style="{StaticResource EyebrowTextStyle}" />
            </Grid>

            <Grid Grid.Row="3">
                <TextBlock x:Uid="Providers_NoMatches" x:Name="NoMatchesText" Visibility="Collapsed"
                           HorizontalAlignment="Center" Margin="24" Foreground="{ThemeResource TextSecondaryBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <ItemsControl x:Name="WideConnections" ItemsSource="{x:Bind FilteredConnections, Mode=OneWay}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,10" Padding="18,12">
                                <Grid ColumnSpacing="18" MinHeight="60">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" MinWidth="180" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="1.3*" MinWidth="140" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding Accent}" CornerRadius="3" Width="6" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DisplayAccount}" Foreground="{ThemeResource TextSecondaryBrush}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding DisplayAccount}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding AuthSource}" VerticalAlignment="Center"
                                               FontFamily="{ThemeResource MetricFont}" FontSize="12"
                                               TextWrapping="Wrap" ToolTipService.ToolTip="{Binding AuthSource}" />
                                    <Grid Grid.Column="3" ColumnSpacing="6" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{Binding StatusKind, Converter={StaticResource CardStatusBrush}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Health}" FontSize="12" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" ToolTipService.ToolTip="{Binding Health}" />
                                    </Grid>
                                    <TextBlock Grid.Column="4" Text="{Binding Coverage}" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" ToolTipService.ToolTip="{Binding Coverage}" />
                                    <!-- The label wraps inside a fixed action column so every localized
                                         provider action remains readable without widening the page. -->
                                    <Button Grid.Column="5" Click="OnConnectionActionClick"
                                            VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                            ToolTipService.ToolTip="{Binding ActionLabel}"
                                            Visibility="{Binding ActionLabel, Converter={StaticResource StringVisibility}}">
                                        <TextBlock Text="{Binding ActionLabel}" TextWrapping="Wrap"
                                                   TextAlignment="Center" HorizontalAlignment="Stretch" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl x:Name="NarrowConnections" Visibility="Collapsed"
                              ItemsSource="{x:Bind FilteredConnections, Mode=OneWay}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,10" Padding="16,14">
                                <Grid ColumnSpacing="12" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.RowSpan="5" Background="{Binding Accent}" CornerRadius="3" Width="6" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DisplayAccount}" Foreground="{ThemeResource TextSecondaryBrush}"
                                                   FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <TextBlock x:Uid="Providers_AuthSource" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="{Binding AuthSource}" FontFamily="{ThemeResource MetricFont}"
                                                   FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                                        <TextBlock x:Uid="Providers_ColumnStatus" Style="{StaticResource EyebrowTextStyle}" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{Binding StatusKind, Converter={StaticResource CardStatusBrush}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Health}" FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2">
                                        <TextBlock x:Uid="Providers_WhatThisMeans" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="{Binding Coverage}" FontSize="12"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Row="4" Grid.Column="1" Click="OnConnectionActionClick"
                                            HorizontalAlignment="Stretch" ToolTipService.ToolTip="{Binding ActionLabel}"
                                            Visibility="{Binding ActionLabel, Converter={StaticResource StringVisibility}}">
                                        <TextBlock Text="{Binding ActionLabel}" TextWrapping="Wrap"
                                                   TextAlignment="Center" HorizontalAlignment="Stretch" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
