<Page
    x:Class="AiLimits.Presentation.WinUI.Pages.UsagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AiLimits.Presentation.WinUI.Controls"
    xmlns:converters="using:AiLimits.Presentation.WinUI.Converters"
    Background="{ThemeResource PageBackgroundBrush}">
    <Page.Resources>
        <converters:BooleanVisibilityConverter x:Key="BooleanVisibility" />
        <Style x:Key="QueryLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource EyebrowTextStyle}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="CharacterSpacing" Value="120" />
        </Style>
        <Style x:Key="QueryPanelStyle" TargetType="Border" BasedOn="{StaticResource SurfaceBorderStyle}">
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="FacetListStyle" TargetType="ListView">
            <Setter Property="SelectionMode" Value="Multiple" />
            <Setter Property="IsMultiSelectCheckBoxEnabled" Value="True" />
            <Setter Property="MaxHeight" Value="118" />
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="ItemTemplate" Value="{StaticResource FacetItemTemplate}" />
        </Style>
        <DataTemplate x:Key="FacetItemTemplate">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Label}" />
        </DataTemplate>
        <Style x:Key="ChartSeriesToggleStyle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <!-- Numeric column widths, repeated verbatim by the breakdown header
             and its row template. WinUI has no SharedSizeGroup, so the two
             grids only line up if these stay identical in both places. -->
        <Style x:Key="SplitNumberStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource MetricFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextQuietBrush}" />
        </Style>
        <Style x:Key="SplitHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource QueryLabelStyle}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="0,0,0,1" Padding="30,22">
            <controls:AdaptiveHeaderPanel MinContentWidth="320" Spacing="20">
                <StackPanel MaxWidth="760" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Uid="Usage_Eyebrow" Text="USAGE" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" />
                        <Border Background="{ThemeResource PillPositiveBackgroundBrush}" CornerRadius="12" Padding="9,3"><TextBlock x:Uid="Usage_OnDevicePill" Text="ON-DEVICE" FontFamily="{ThemeResource MetricFont}" FontSize="9" Foreground="{ThemeResource PillPositiveForegroundBrush}" /></Border>
                    </StackPanel>
                    <TextBlock x:Uid="Usage_Title" Text="Filter and break down your usage." FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Uid="Usage_QuerySummary" x:Name="QuerySummaryText" Text="Last 30 days · all activity" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="7">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button x:Uid="Usage_ResetQuery" x:Name="ResetQueryButton" Content="Reset query" Click="OnResetQuery" />
                        <Button x:Uid="Usage_RefreshData" Content="Refresh data" Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                    <!-- Same live progress strip as Overview: a refresh takes
                         long enough that a disabled gray button reads as a
                         hang rather than as work in flight. -->
                    <StackPanel Spacing="4" MinWidth="190"
                                Visibility="{x:Bind ViewModel.IsRefreshing, Mode=OneWay, Converter={StaticResource BooleanVisibility}}">
                        <ProgressBar Value="{x:Bind ViewModel.RefreshProgressFraction, Mode=OneWay}"
                                     IsIndeterminate="{x:Bind ViewModel.RefreshIsIndeterminate, Mode=OneWay}"
                                     Maximum="1" Minimum="0" HorizontalAlignment="Stretch" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.RefreshProgressLabel, Mode=OneWay}"
                                       Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.RefreshProgressDetail, Mode=OneWay}"
                                       FontSize="11" Foreground="{ThemeResource TextQuietBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </controls:AdaptiveHeaderPanel>
        </Border>

        <!-- Kept as a plain Grid on purpose: wrapping it in a horizontal
             ScrollViewer makes the star column measure against infinity, so
             the chart overruns the window instead of filling it. The narrow
             case is handled by keeping the side columns small enough that all
             three fit at ~870px. -->
        <Grid Grid.Row="1" Padding="20,18,20,28" ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>

            <Border Style="{StaticResource QueryPanelStyle}" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Uid="Usage_QueryEyebrow" Text="QUERY" Style="{StaticResource QueryLabelStyle}"/>
                                <TextBlock x:Uid="Usage_QueryTitle" Text="Filter the ledger" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Uid="Usage_ActiveFilters" x:Name="ActiveFilterCountText" Text="0 active" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontFamily="{ThemeResource MetricFont}" FontSize="10" Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </Grid>

                        <StackPanel Spacing="5">
                            <TextBlock x:Uid="Usage_DateRangeLabel" Text="Date range" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <ComboBox x:Name="DateRangePicker" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="OnDateRangeChanged">
                                <ComboBoxItem x:Uid="Usage_Window7" Content="Last 7 days" Tag="7"/><ComboBoxItem x:Uid="Usage_Window30" Content="Last 30 days" Tag="30"/><ComboBoxItem x:Uid="Usage_Window90" Content="Last 90 days" Tag="90"/><ComboBoxItem x:Uid="Usage_Window365" Content="Last year" Tag="365"/><ComboBoxItem x:Uid="Usage_WindowCustom" Content="Custom range…" Tag="custom"/>
                            </ComboBox>
                            <StackPanel x:Name="CustomRangePanel" Visibility="Collapsed" Spacing="6" Margin="0,4,0,0">
                                <DatePicker x:Uid="Usage_FromDate" x:Name="FromDatePicker" Header="From" />
                                <DatePicker x:Uid="Usage_ThroughDate" x:Name="ThroughDatePicker" Header="Through" />
                                <Button x:Uid="Usage_ApplyDates" Content="Apply dates" Click="OnApplyCustomRange" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock x:Uid="Usage_TimeGrainLabel" Text="Time grain" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <ComboBox x:Name="TimeGrainPicker" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnQueryControlChanged">
                                <ComboBoxItem x:Uid="Usage_GrainAuto" Content="Auto" Tag="auto"/>
                                <ComboBoxItem x:Uid="Usage_GrainDay" Content="Day" Tag="day"/>
                                <ComboBoxItem x:Uid="Usage_GrainWeek" Content="Week" Tag="week"/>
                                <ComboBoxItem x:Uid="Usage_GrainMonth" Content="Month" Tag="month"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock x:Uid="Usage_CompareLabel" Text="Compare" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <ComboBox x:Name="ComparePicker" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnQueryControlChanged">
                                <ComboBoxItem x:Uid="Usage_ComparePrevious" Content="Previous" Tag="previous"/>
                                <ComboBoxItem x:Uid="Usage_CompareOff" Content="Off" Tag="none"/>
                            </ComboBox>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource SurfaceStrokeBrush}" />

                        <StackPanel Spacing="5">
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Uid="Usage_ProviderEyebrow" Text="PROVIDER" Style="{StaticResource QueryLabelStyle}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="ProviderCountText" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{ThemeResource MetricFont}" FontSize="9" Foreground="{ThemeResource TextQuietBrush}"/></Grid>
                            <ListView x:Name="ProviderFilter" Style="{StaticResource FacetListStyle}" SelectionChanged="OnProviderSelectionChanged" />
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Uid="Usage_HarnessEyebrow" Text="HARNESS" Style="{StaticResource QueryLabelStyle}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="HarnessCountText" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{ThemeResource MetricFont}" FontSize="9" Foreground="{ThemeResource TextQuietBrush}"/></Grid>
                            <ListView x:Name="HarnessFilter" Style="{StaticResource FacetListStyle}" SelectionChanged="OnHarnessSelectionChanged" />
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <!-- This label wraps instead of trimming. It is the longest of the
                                 facet headings and shares its row with the count, so at this
                                 panel width it always read as "PROJECT / WORK…" whatever the
                                 window was doing. -->
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Uid="Usage_ProjectEyebrow" x:Name="ProjectEyebrowLabel" Text="PROJECT / WORKTREE" Style="{StaticResource QueryLabelStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="ProjectCountText" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{ThemeResource MetricFont}" FontSize="9" Foreground="{ThemeResource TextQuietBrush}"/></Grid>
                            <TextBox x:Uid="Usage_ProjectSearch" x:Name="ProjectSearchBox" PlaceholderText="Find a project" TextChanged="OnProjectSearchChanged" />
                            <ListView x:Name="ProjectFilter" Style="{StaticResource FacetListStyle}" SelectionChanged="OnProjectSelectionChanged" />
                            <!-- Shown only when the window actually contains usage from a
                                 harness that reports no working directory, and it names
                                 just those. Collapsed is the right default: most queries
                                 involve none of them. -->
                            <Border x:Name="ProjectSourceNote" Visibility="Collapsed"
                                    BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,1,0,0">
                                <TextBlock x:Name="ProjectSourceNoteText" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Uid="Usage_ModelEyebrow" Text="MODEL" Style="{StaticResource QueryLabelStyle}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="ModelCountText" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{ThemeResource MetricFont}" FontSize="9" Foreground="{ThemeResource TextQuietBrush}"/></Grid>
                            <TextBox x:Uid="Usage_ModelSearch" x:Name="ModelSearchBox" PlaceholderText="Find a model" TextChanged="OnModelSearchChanged" />
                            <ListView x:Name="ModelFilter" Style="{StaticResource FacetListStyle}" SelectionChanged="OnModelSelectionChanged" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <Border Style="{StaticResource QueryPanelStyle}" Padding="22">
                        <StackPanel>
                            <controls:AdaptiveHeaderPanel MinContentWidth="200" Spacing="14">
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock x:Uid="Usage_ChartEyebrow" Text="TOKENS OVER TIME" Style="{StaticResource QueryLabelStyle}"/>
                                    <TextBlock x:Name="TotalTokensText" Text="—" FontFamily="{ThemeResource MetricFont}" FontSize="31" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock x:Uid="Usage_WindowInitial" x:Name="WindowLabelText" Text="LAST 30 DAYS" Style="{StaticResource QueryLabelStyle}" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="ComparisonText" Text="—" Foreground="{ThemeResource TextPrimaryBrush}" FontFamily="{ThemeResource MetricFont}" FontSize="12" HorizontalAlignment="Right" Margin="0,5,0,0" TextWrapping="Wrap" TextAlignment="Right"/>
                                </StackPanel>
                            </controls:AdaptiveHeaderPanel>
                            <StackPanel Spacing="8" Margin="0,14,0,0">
                                <!-- Wraps rather than stacks horizontally: three toggles plus the
                                     caption do not fit the centre column on a narrow window, and a
                                     StackPanel would push the last one off the edge. -->
                                <controls:WrapRowPanel>
                                    <TextBlock x:Uid="Usage_SeriesBy" Text="SERIES BY" Style="{StaticResource QueryLabelStyle}" VerticalAlignment="Center" Margin="0,0,11,6"/>
                                    <ToggleButton x:Uid="Usage_SeriesProvider" x:Name="ChartSeriesProviderButton" Content="Provider" IsChecked="True" Style="{StaticResource ChartSeriesToggleStyle}" Margin="0,0,8,6" VerticalAlignment="Center" Click="OnChartSeriesProviderClicked"/>
                                    <ToggleButton x:Uid="Usage_SeriesHarness" x:Name="ChartSeriesHarnessButton" Content="Harness" Style="{StaticResource ChartSeriesToggleStyle}" Margin="0,0,8,6" VerticalAlignment="Center" Click="OnChartSeriesHarnessClicked"/>
                                    <ToggleButton x:Uid="Usage_SeriesModel" x:Name="ChartSeriesModelButton" Content="Model" Style="{StaticResource ChartSeriesToggleStyle}" Margin="0,0,8,6" VerticalAlignment="Center" Click="OnChartSeriesModelClicked"/>
                                </controls:WrapRowPanel>
                                <ItemsControl x:Name="ChartLegendItems">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
                                            <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Brush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="190" ToolTipService.ToolTip="{Binding Label}"/>
                                            <TextBlock Text="{Binding ShareLabel}" FontFamily="{ThemeResource MetricFont}" FontSize="11" Foreground="{ThemeResource TextQuietBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock x:Uid="Usage_ChartEmpty" x:Name="EmptyStateText" Text="No usage matches this query. Clear a filter or widen the date range." Visibility="Collapsed" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,64,0,64" TextWrapping="Wrap" />
                            <Grid x:Name="ChartPlotHost" Height="248" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="210"/><RowDefinition Height="38"/></Grid.RowDefinitions>

                                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" IsHitTestVisible="False">
                                    <TextBlock x:Name="YAxisMaxText" FontFamily="{ThemeResource MetricFont}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="YAxisMidText" FontFamily="{ThemeResource MetricFont}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="YAxisZeroText" Text="0" FontFamily="{ThemeResource MetricFont}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="Usage_TokensAxis" Text="TOKENS" Style="{StaticResource QueryLabelStyle}" FontSize="9" HorizontalAlignment="Right" Margin="0,9,10,0"/>

                                <Grid Grid.Row="0" Grid.Column="1" IsHitTestVisible="False">
                                    <Rectangle Height="1" Fill="{ThemeResource SurfaceStrokeBrush}" VerticalAlignment="Top"/>
                                    <Rectangle Height="1" Fill="{ThemeResource SurfaceStrokeBrush}" VerticalAlignment="Center"/>
                                    <Rectangle Height="1" Fill="{ThemeResource SurfaceStrokeBrush}" VerticalAlignment="Bottom"/>
                                </Grid>

                                <ScrollViewer x:Name="ChartScrollViewer" Grid.RowSpan="2" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled" SizeChanged="OnChartViewportSizeChanged">
                                    <!-- The chart is one Tab stop ("Once"); Left/Right then move
                                         between bars via XY focus. Each bar is focusable, named
                                         for screen readers, and shows the hover card on focus. -->
                                    <ItemsControl x:Name="ChartItems" TabNavigation="Once" XYFocusKeyboardNavigation="Enabled">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <!-- A bar is hover-only. Background must stay Transparent
                                                 rather than unset, or the cell is not hit-testable and
                                                 the hover card never appears between segments. -->
                                            <Grid Width="{Binding ItemWidth}" Height="248" Background="Transparent"
                                                  IsTabStop="True" UseSystemFocusVisuals="True" FocusVisualMargin="-2"
                                                  AutomationProperties.Name="{Binding AutomationName}"
                                                  GotFocus="OnChartBarGotFocus" LostFocus="OnChartBarLostFocus"
                                                  ToolTipService.ToolTip="{Binding Tooltip}"
                                                  PointerEntered="OnChartBarPointerMoved" PointerMoved="OnChartBarPointerMoved" PointerExited="OnChartBarPointerExited">
                                                <Grid.RowDefinitions><RowDefinition Height="210"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                                                <StackPanel Width="{Binding BarWidth}" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                    <ItemsControl ItemsSource="{Binding Segments}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate><DataTemplate>
                                                            <Border Height="{Binding Height}" Background="{Binding Brush}" CornerRadius="2"/>
                                                        </DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Date labels are positioned absolutely rather than living inside
                                     each bar: a bar cell is only ~10px wide on a 30-day window, and
                                     anything drawn inside it gets clipped to that width. -->
                                <Canvas x:Name="ChartAxisCanvas" Grid.Row="1" Grid.Column="1" IsHitTestVisible="False" />

                                <Canvas Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False" Canvas.ZIndex="10">
                                    <Border x:Name="ChartHoverCard" Visibility="Collapsed" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource FocusBrush}" BorderThickness="1" CornerRadius="6" Padding="12,9">
                                        <StackPanel>
                                            <TextBlock x:Name="ChartHoverRangeText" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="ChartHoverTokensText" FontFamily="{ThemeResource MetricFont}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                            <ItemsControl x:Name="ChartHoverDetails" Margin="0,7,0,0" MaxWidth="320">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="8" Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="9" Height="9" CornerRadius="2" Background="{Binding Brush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" FontFamily="{ThemeResource MetricFont}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource QueryPanelStyle}" Padding="20,16">
                        <StackPanel Spacing="3">
                            <TextBlock x:Uid="Usage_MatchingEyebrow" Text="MATCHING DATA" Style="{StaticResource QueryLabelStyle}"/>
                            <TextBlock x:Name="MatchingRecordsText" Text="—" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="MatchingRecordsDetailText" Text="—" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Which models ran and when, for whatever the query is
                         currently scoped to: pick a harness on the left and
                         this answers "how much of that was which model". -->
                    <Border Style="{StaticResource QueryPanelStyle}" Padding="20,16">
                        <StackPanel Spacing="12">
                            <controls:AdaptiveHeaderPanel MinContentWidth="240" Spacing="14">
                                <StackPanel Spacing="2" VerticalAlignment="Bottom">
                                    <TextBlock x:Uid="Usage_ModelMixEyebrow" Text="MODEL MIX" Style="{StaticResource QueryLabelStyle}"/>
                                    <TextBlock x:Name="ModelMixSubtitleText" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock x:Name="ModelMixWindowText" Style="{StaticResource QueryLabelStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </controls:AdaptiveHeaderPanel>

                            <TextBlock x:Uid="Usage_ModelMixEmpty" x:Name="ModelMixEmptyText" Text="No models match this query." Visibility="Collapsed" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,8"/>

                            <ItemsControl x:Name="ModelMixItems">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid Padding="0,10" BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="0,1,0,0" ColumnSpacing="14" RowSpacing="7"
                                          IsTabStop="True" UseSystemFocusVisuals="True" FocusVisualMargin="-2"
                                          AutomationProperties.Name="{Binding AutomationName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="150"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                            <Border Width="4" Height="20" CornerRadius="2" Background="{Binding Accent}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Label}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Tokens}" FontFamily="{ThemeResource MetricFont}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ShareLabel}" FontFamily="{ThemeResource MetricFont}" FontSize="12" Foreground="{ThemeResource TextQuietBrush}" VerticalAlignment="Center" MinWidth="44" TextAlignment="Right"/>
                                            <TextBlock Text="{Binding Cost}" FontFamily="{ThemeResource MetricFont}" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" MinWidth="64" TextAlignment="Right"/>
                                        </StackPanel>

                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Spark}" Height="30" VerticalAlignment="Bottom">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Grid Width="{Binding Width}" Height="30" ToolTipService.ToolTip="{Binding Tooltip}"
                                                      AutomationProperties.Name="{Binding AutomationName}">
                                                    <Border Height="{Binding Height}" Background="{Binding Brush}" Opacity="{Binding Opacity}" CornerRadius="1" VerticalAlignment="Bottom"/>
                                                </Grid>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActivityLabel}" FontSize="12" Foreground="{ThemeResource TextQuietBrush}"
                                                   VerticalAlignment="Bottom" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Button x:Name="ModelMixShowMoreButton" Visibility="Collapsed" Click="OnModelMixShowMore"/>
                                <Button x:Name="ModelMixShowLessButton" Visibility="Collapsed" Click="OnModelMixShowLess"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource QueryPanelStyle}" Padding="18,14">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="Usage_BreakdownEyebrow" Text="TOKEN BREAKDOWN" Style="{StaticResource QueryLabelStyle}"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                                <StackPanel MinWidth="700">
                                    <Grid Padding="0,0,0,6" BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="0,0,0,1" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="150"/>
                                            <ColumnDefinition Width="92"/><ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="84"/><ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="88"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Usage_ColLabel" Text="Label" Style="{StaticResource QueryLabelStyle}" FontSize="10" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" x:Uid="Usage_ColTokens" Text="Tokens" Style="{StaticResource SplitHeaderStyle}"/>
                                        <TextBlock Grid.Column="2" x:Uid="Usage_ColIn" Text="In" Style="{StaticResource SplitHeaderStyle}"/>
                                        <TextBlock Grid.Column="3" x:Uid="Usage_ColOut" Text="Out" Style="{StaticResource SplitHeaderStyle}"/>
                                        <TextBlock Grid.Column="4" x:Uid="Usage_ColCacheR" Text="Cache R" Style="{StaticResource SplitHeaderStyle}"/>
                                        <TextBlock Grid.Column="5" x:Uid="Usage_ColCacheW" Text="Cache W" Style="{StaticResource SplitHeaderStyle}"/>
                                        <TextBlock Grid.Column="6" x:Uid="Usage_ColReason" Text="Reason" Style="{StaticResource SplitHeaderStyle}"/>
                                        <TextBlock Grid.Column="7" x:Uid="Usage_ColApi" Text="API $" Style="{StaticResource SplitHeaderStyle}"/>
                                    </Grid>
                                    <ItemsControl x:Name="TokenSplitTable">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Grid Padding="0,9" BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="0,1,0,0" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="150"/>
                                                    <ColumnDefinition Width="92"/><ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="80"/><ColumnDefinition Width="84"/>
                                                    <ColumnDefinition Width="84"/><ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="88"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Label}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Tokens}" Style="{StaticResource SplitNumberStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding InputTokens}" Style="{StaticResource SplitNumberStyle}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding OutputTokens}" Style="{StaticResource SplitNumberStyle}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding CacheReadTokens}" Style="{StaticResource SplitNumberStyle}"/>
                                                <TextBlock Grid.Column="5" Text="{Binding CacheWriteTokens}" Style="{StaticResource SplitNumberStyle}"/>
                                                <TextBlock Grid.Column="6" Text="{Binding ReasoningTokens}" Style="{StaticResource SplitNumberStyle}"/>
                                                <TextBlock Grid.Column="7" Text="{Binding ApiEquivalent}" Style="{StaticResource SplitNumberStyle}" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <Border Style="{StaticResource QueryPanelStyle}"><StackPanel Spacing="8">
                        <TextBlock x:Uid="Usage_ApiEquivalentEyebrow" Text="API EQUIVALENT" Style="{StaticResource QueryLabelStyle}"/>
                        <TextBlock x:Name="ApiEquivalentText" Text="—" FontFamily="{ThemeResource MetricFont}" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                        <TextBlock x:Uid="Usage_PricingCoverage" x:Name="PricingCoverageText" Text="Public API-price estimate" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel></Border>

                    <Border Style="{StaticResource QueryPanelStyle}"><StackPanel Spacing="8">
                        <TextBlock x:Uid="Usage_BreakdownBy" Text="BREAK DOWN BY" Style="{StaticResource QueryLabelStyle}"/>
                        <ComboBox x:Name="BreakdownPicker" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnBreakdownChanged"><ComboBoxItem x:Uid="Usage_BreakdownProvider" Content="Provider" Tag="provider"/><ComboBoxItem x:Uid="Usage_BreakdownHarness" Content="Harness" Tag="tool"/><ComboBoxItem x:Uid="Usage_BreakdownProject" Content="Project / worktree" Tag="project"/><ComboBoxItem x:Uid="Usage_BreakdownModel" Content="Model" Tag="model"/></ComboBox>
                        <ItemsControl x:Name="BreakdownItems">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <!-- No separator rule between rows: each row already ends in a
                                     full-width bar track, so a divider on top of that read as a
                                     stray second line. Spacing alone separates the rows. -->
                                <Grid Padding="0,11" ColumnSpacing="9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Label}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding Tokens}" FontFamily="{ThemeResource MetricFont}" HorizontalAlignment="Right"/><TextBlock Text="{Binding ShareLabel}" FontFamily="{ThemeResource MetricFont}" FontSize="10" Foreground="{ThemeResource TextQuietBrush}" HorizontalAlignment="Right"/></StackPanel>
                                    <!-- Spans both columns. Confined to the star column it ran out
                                         of room beside the token figures, so a 100% share stopped
                                         about two thirds across and never read as full. The track
                                         is tinted for the same reason: without it there is nothing
                                         to show where 100% would end. -->
                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Maximum="100" Value="{Binding SharePercent}"
                                                 Margin="0,7,0,0" Background="{ThemeResource SurfaceStrokeBrush}"/>
                                </Grid>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button x:Name="BreakdownShowMoreButton" Visibility="Collapsed" Click="OnBreakdownShowMore"/>
                            <Button x:Name="BreakdownShowLessButton" Visibility="Collapsed" Click="OnBreakdownShowLess"/>
                        </StackPanel>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
