<UserControl
    x:Class="AiLimits.Presentation.WinUI.Controls.ResetHorizon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer
        HorizontalScrollBarVisibility="Auto"
        HorizontalScrollMode="Enabled"
        VerticalScrollMode="Disabled"
        VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="10" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        MinWidth="218"
                        MaxWidth="300"
                        Padding="14"
                        CornerRadius="8"
                        Background="{ThemeResource SurfaceSecondaryBrush}"
                        AutomationProperties.Name="{Binding AutomationName}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.RowSpan="3" CornerRadius="2" Background="{Binding Accent}" />
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Provider}" Style="{StaticResource EyebrowTextStyle}"
                                       ToolTipService.ToolTip="{Binding Provider}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="10,4,0,0" Text="{Binding Countdown}" FontFamily="{ThemeResource MetricFont}" FontSize="20" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,4,0,0">
                                <TextBlock Text="{Binding Meter}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Meter}" />
                                <TextBlock Text="{Binding ResetTime}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>

