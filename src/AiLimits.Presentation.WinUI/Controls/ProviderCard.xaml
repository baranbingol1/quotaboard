<UserControl
    x:Class="AiLimits.Presentation.WinUI.Controls.ProviderCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AiLimits.Presentation.WinUI.Controls"
    xmlns:converters="using:AiLimits.Presentation.WinUI.Converters">
    <UserControl.Resources>
        <converters:StringVisibilityConverter x:Key="StringVisibilityConverter" />
        <converters:CardStatusBrushConverter x:Key="CardStatusBrushConverter" />
    </UserControl.Resources>
    <Border
        Style="{StaticResource SurfaceBorderStyle}"
        MinWidth="310"
        MinHeight="275"
        AutomationProperties.Name="{Binding Name}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="4" Height="38" CornerRadius="2" Background="{Binding Accent}" />
                <StackPanel Grid.Column="1" Margin="12,0,8,0">
                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{Binding Name}" />
                    <TextBlock Text="{Binding DisplayAccount}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid Grid.Column="2" ColumnSpacing="6" VerticalAlignment="Top" Margin="8,5,0,0"
                      ToolTipService.ToolTip="{Binding StatusTooltip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{Binding StatusKind, Converter={StaticResource CardStatusBrushConverter}}" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusShortLabel}" Style="{StaticResource EyebrowTextStyle}"
                               VerticalAlignment="Center" MaxWidth="110" />
                </Grid>
            </Grid>
            <Border
                Grid.Row="1"
                Margin="0,12,0,0" Padding="10,8" CornerRadius="6"
                Background="{ThemeResource IncidentBackgroundBrush}" BorderBrush="{ThemeResource IncidentBorderBrush}" BorderThickness="1"
                Visibility="{Binding IncidentVisibility}">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding IncidentBadge}" Style="{StaticResource EyebrowTextStyle}" Foreground="{ThemeResource IncidentForegroundBrush}" />
                    <TextBlock Text="{Binding IncidentSummary}" FontSize="12" TextWrapping="Wrap" MaxLines="2"
                               ToolTipService.ToolTip="{Binding IncidentSummary}" />
                </StackPanel>
            </Border>
            <TextBlock
                Grid.Row="2"
                Margin="0,12,0,0"
                Text="{Binding BalanceLabel}"
                FontFamily="{ThemeResource MetricFont}"
                FontSize="12"
                Foreground="{ThemeResource TextSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{Binding BalanceLabel}"
                Visibility="{Binding BalanceLabel, Converter={StaticResource StringVisibilityConverter}}" />
            <ItemsControl x:Name="Meters" Grid.Row="3" ItemsSource="{Binding VisibleMeters}" Margin="0,5,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:MeterRow />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <HyperlinkButton
                x:Name="MoreButton"
                Grid.Row="4"
                Margin="0,6,0,0"
                Padding="2,4"
                Click="OnMoreClick">
                <TextBlock x:Name="MoreLabelText" Text="{Binding MoreLabel}" Style="{StaticResource EyebrowTextStyle}" />
            </HyperlinkButton>
        </Grid>
    </Border>
</UserControl>

